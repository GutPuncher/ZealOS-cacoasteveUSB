//Place this file in /Home and change
//anything you want.

//This file is executed by the
//first terminal window upon start-up.
//See $LK,"Once",A="FF:~/HomeSys.ZC,Once"$ and $LK,"Home Files",A="FF:::/Doc/GuideLines.DD,/Home Files"$.

//Delete the rest from this file.

// Run UdRun; manually after BootHDInsAuto when you want native USB input.
// Do not auto-init USB here - it steals RAM for kernel compiles and can trip the debugger.

U0 NormalRebuildTask()
{
	while (!Bt(&sys_run_level, RLf_SYSTEM_SERVER))
		Sleep(250);
	Sleep(2000);
	Cd("C:/Home");
	"Normal boot kernel rebuild starting...\n";
	ExeFile("C:/Home/BootKernelFull");
}

Cd("C:/Home");
if (FileFind("C:/Home/UsbBootLast.DD"))
{
	"\n$$PURPLE$$USB boot last$$FG$$\n";
	Type("C:/Home/UsbBootLast.DD");
	"\n";
}
if (FileFind("NormalRebuildKernel.DD"))
{
	Del("NormalRebuildKernel.DD",, FALSE, FALSE);
	Del(".normal_rebuild_kernel",, FALSE, FALSE);
	Del("OnceRebuildKernel.DD",, FALSE, FALSE);
	Del(".once_rebuild_kernel",, FALSE, FALSE);
	"Kernel rebuild queued after normal boot finishes...\n";
	NormalRebuildTask;
}
else if (FileFind(".normal_rebuild_kernel"))
{
	Del(".normal_rebuild_kernel",, FALSE, FALSE);
	Del("OnceRebuildKernel.DD",, FALSE, FALSE);
	Del(".once_rebuild_kernel",, FALSE, FALSE);
	"Kernel rebuild queued after normal boot finishes...\n";
	NormalRebuildTask;
}
else if (FileFind("OnceRebuildKernel.DD"))
{
	Del("OnceRebuildKernel.DD",, FALSE, FALSE);
	Del(".once_rebuild_kernel",, FALSE, FALSE);
	"Kernel rebuild queued after normal boot finishes...\n";
	NormalRebuildTask;
}
else if (FileFind(".once_rebuild_kernel"))
{
	Del(".once_rebuild_kernel",, FALSE, FALSE);
	"Kernel rebuild queued after normal boot finishes...\n";
	NormalRebuildTask;
}

U0 Tmp()
{
	OnceExe;
	switch (sys_boot_src.u16[0])
	{
		case BOOT_SRC_ROM:
			"Continue booting hard drive ";
			if (YorN)
			{
				DocBottom;
				ExeFile("C:/Home/Once");
			}
			break;
		case BOOT_SRC_DVD:
			"\nIf you answer 'No' you can play with\n"
			"the live CD without installing.\n\n"
			"Install onto hard drive ";

			if (YorN)
			{
				DocBottom;
				RunFile("::/Misc/OSInstall",, TRUE);
			}
			if (FileFind("::/Misc/Tour"))
			{
				"\nTake Tour";
				if (YorN) {
					DocBottom;
					Cd("::/Misc/Tour");
					InFile("Tour");
				}
			}
			break;
		case BOOT_SRC_HARDDRIVE:
		case BOOT_SRC_RAM:
			"\n$$PURPLE$$$$TX+CX,\"Tips of the Day\"$$$$FG$$\n";
			TipOfDay;Yield;
			TipOfDay;
			Type("::/Doc/Customize.DD");
			break;
	}
}
Tmp;
