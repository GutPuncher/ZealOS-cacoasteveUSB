// USB input debug demo. Lists UHCI/EHCI/xHCI controllers and active USB input status.

#define UK	1
#define UM	2

U0 USBInputRep()
{
	I64 bdf, class_code;

	"\nUSB Input Status\n";
	"usb_debug_stage: %d\n", usb_debug_stage;
	"sys_usb_input_active: 0x%X\n", sys_usb_input_active;
	if (sys_usb_input_active & UK)
		"  Native USB keyboard active\n";
	if (sys_usb_input_active & UM)
		"  Native USB mouse active\n";
	if (!sys_usb_input_active)
		"  Using PS/2 fallback (or no input yet)\n";

	class_code = PCIC_SERIAL << 16;
	class_code = class_code | (PCISC_USB << 8);
	class_code = class_code | PCIP_USB_UHCI;
	bdf = PCIClassFind(class_code, 0);
	if (bdf == -1)
		"No UHCI controller found.\n";
	else
		"UHCI BDF: 0x%X\n", bdf;

	class_code = PCIC_SERIAL << 16;
	class_code = class_code | (PCISC_USB << 8);
	class_code = class_code | PCIP_USB_XHCI;
	bdf = PCIClassFind(class_code, 0);
	if (bdf == -1)
		"No xHCI controller found.\n";
	else
		"xHCI BDF: 0x%X\n", bdf;

	class_code = PCIC_SERIAL << 16;
	class_code = class_code | (PCISC_USB << 8);
	class_code = class_code | PCIP_USB_EHCI;
	bdf = PCIClassFind(class_code, 0);
	if (bdf == -1)
		"No EHCI controller found.\n";
	else
		"EHCI BDF: 0x%X\n", bdf;

}

U0 USBInput()
{
	I64 i;

	"\nBefore USBInit:\n";
	USBInputRep();
	"\nInitializing native USB input...\n";
	DebugTrapsClear;
	UdRun;
	UdBgResume;
	"\nAfter USBInit (usb_debug_stage=%d active=0x%X):\n", usb_debug_stage, sys_usb_input_active;

	USBInputRep();
	"\nPolling USB/PS2 input for 10 seconds...\n";
	for (i = 0; i < 1000; i++)
	{
		if (sys_usb_input_active)
			UsbPollEvt;
		KbdMouseHandler(TRUE, TRUE);
		Sleep(10);
	}
	"Done.\n";
}

USBInput();
