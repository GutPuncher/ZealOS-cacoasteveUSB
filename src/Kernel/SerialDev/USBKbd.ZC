#include "USB"

I64 USBUsageToScanCode(U8 usage)
{
	switch (usage)
	{
		case 0x04: return 0x1E; // A
		case 0x05: return 0x30; // B
		case 0x06: return 0x2E; // C
		case 0x07: return 0x20; // D
		case 0x08: return 0x12; // E
		case 0x09: return 0x21; // F
		case 0x0A: return 0x22; // G
		case 0x0B: return 0x23; // H
		case 0x0C: return 0x17; // I
		case 0x0D: return 0x24; // J
		case 0x0E: return 0x25; // K
		case 0x0F: return 0x26; // L
		case 0x10: return 0x32; // M
		case 0x11: return 0x31; // N
		case 0x12: return 0x18; // O
		case 0x13: return 0x19; // P
		case 0x14: return 0x10; // Q
		case 0x15: return 0x13; // R
		case 0x16: return 0x1F; // S
		case 0x17: return 0x14; // T
		case 0x18: return 0x16; // U
		case 0x19: return 0x2F; // V
		case 0x1A: return 0x11; // W
		case 0x1B: return 0x2D; // X
		case 0x1C: return 0x15; // Y
		case 0x1D: return 0x2C; // Z
		case 0x1E: return 0x02; // 1
		case 0x1F: return 0x03; // 2
		case 0x20: return 0x04; // 3
		case 0x21: return 0x05; // 4
		case 0x22: return 0x06; // 5
		case 0x23: return 0x07; // 6
		case 0x24: return 0x08; // 7
		case 0x25: return 0x09; // 8
		case 0x26: return 0x0A; // 9
		case 0x27: return 0x0B; // 0
		case 0x28: return SC_ENTER;
		case 0x29: return SC_ESC;
		case 0x2A: return SC_BACKSPACE;
		case 0x2B: return SC_TAB;
		case 0x2C: return 0x39; // Space
		case 0x2D: return 0x0C; // -
		case 0x2E: return 0x0D; // =
		case 0x2F: return 0x1A; // [
		case 0x30: return 0x1B; // ]
		case 0x31: return 0x2B; // Backslash
		case 0x33: return 0x27; // ;
		case 0x34: return 0x28; // '
		case 0x35: return 0x29; // `
		case 0x36: return 0x33; // ,
		case 0x37: return 0x34; // .
		case 0x38: return 0x35; // /
		case 0x39: return SC_CAPS;
		case 0x3A: return SC_F1 + (usage - 0x3A);
		case 0x49: return SC_INS;
		case 0x4A: return SC_HOME;
		case 0x4B: return SC_PAGE_UP;
		case 0x4C: return SC_DELETE;
		case 0x4D: return SC_END;
		case 0x4E: return SC_PAGE_DOWN;
		case 0x4F: return SC_CURSOR_RIGHT;
		case 0x50: return SC_CURSOR_LEFT;
		case 0x51: return SC_CURSOR_DOWN;
		case 0x52: return SC_CURSOR_UP;
	}
	return 0;
}

I64 USBModToScFlags(U8 mod)
{
	I64 f = 0;

	if (mod & 1)
		f |= SCF_CTRL;
	else if (mod & 0x10)
		f |= SCF_CTRL;
	if (mod & 2)
		f |= SCF_SHIFT;
	else if (mod & 0x20)
		f |= SCF_SHIFT;
	if (mod & 4)
		f |= SCF_ALT;
	else if (mod & 0x40)
		f |= SCF_ALT;
	return f;
}

U0 USBKbdScanInject(I64 sc, Bool key_up)
{
	if (!sc)
		return;
	if (key_up)
		sc |= SCF_KEY_UP;
	sc |= SCF_NEW_KEY;
	kbd.timestamp = TSCGet;
	kbd.scan_code = sc;
	kbd.new_key_timestamp = kbd.timestamp;
	FifoI64Ins(kbd.scan_code_fifo, kbd.scan_code);
	kbd.count++;
	if (!(sc & SCF_KEY_UP))
	{
		kbd.last_down_scan_code = sc;
		Bts(kbd.down_bitmap, sc.u8[0]);
	}
	else
		Btr(kbd.down_bitmap, sc.u8[0]);
}

Bool USBKbdUsagePresent(U8 usage, U8 *rpt)
{
	I64 i;

	for (i = 2; i < 8; i++)
	{
		if (rpt[i] == usage)
			return TRUE;
	}
	return FALSE;
}

U0 USBKbdReportHandle(U8 *rpt, I64 len)
{
	I64 i, sc, flags;
	U8 usage, mod;

	if (len < 8)
		return;
	mod = rpt[0];
	flags = USBModToScFlags(mod);
	for (i = 2; i < 8; i++)
	{
		usage = rpt[i];
		if (usage)
		{
			if (!USBKbdUsagePresent(usage, usb.kbd_last_rpt))
			{
				sc = USBUsageToScanCode(usage);
				if (sc)
					USBKbdScanInject(sc | flags, FALSE);
			}
		}
	}
	for (i = 2; i < 8; i++)
	{
		usage = usb.kbd_last_rpt[i];
		if (usage)
		{
			if (!USBKbdUsagePresent(usage, rpt))
			{
				sc = USBUsageToScanCode(usage);
				if (sc)
					USBKbdScanInject(sc | flags, TRUE);
			}
		}
	}
	MemCopy(rpt, usb.kbd_last_rpt, 8);
}

U0 USBKbdIntrSubmit()
{
	CXHCITrb trb;

	if (!usb.kbd_ring)
		return;
	MemSet(&trb, 0, sizeof(trb));
	trb.param = usb.ctrl_buf_phys;
	trb.status = usb.kbd_max_pkt << 16;
	trb.control = XHCI_TRB_NORMAL << 10 | 1 << XHCI_TRB_IOC | 1 << XHCI_TRB_DIR_IN | usb.kbd_slot << 24;
	USBEpRingPost(&trb, usb.kbd_ring, &usb.kbd_ring_idx, &usb.kbd_ring_cycle, usb.kbd_ring_phys);
	usb.kbd_pending = TRUE;
	XHCIDoorbell(usb.kbd_slot);
}

U0 USBKbdEventHandle()
{
	if (!usb.kbd_pending)
		return;
	if (!usb.xfer_done)
		return;
	if (!usb.kbd_ring)
		return;
	if (usb.xfer_len)
		USBKbdReportHandle(usb.ctrl_buf, usb.xfer_len);
	usb.kbd_pending = FALSE;
	usb.xfer_done = FALSE;
	USBKbdIntrSubmit;
}
