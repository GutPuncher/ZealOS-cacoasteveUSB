U0 XhmPktIns(I64 dx, I64 dy, I64 b)
{
	I64 ps2[3];

	ps2[0] = 0;
	if (b & 1)
		ps2[0] |= 1;
	if (b & 2)
		ps2[0] |= 2;
	if (b & 4)
		ps2[0] |= 4;
	if (dx < 0)
	{
		ps2[0] |= 0x10;
		ps2[1] = 256 + dx;
	}
	else
		ps2[1] = dx;
	if (dy > 0)
	{
		ps2[0] |= 0x20;
		ps2[2] = 256 - dy;
	}
	else
		ps2[2] = -dy;

	mouse_hard.timestamp = TSCGet;
	FifoU8Insert(mouse_hard.fifo2, ps2[0]);
	FifoU8Insert(mouse_hard.fifo2, ps2[1]);
	FifoU8Insert(mouse_hard.fifo2, ps2[2]);
	mouse_hard.pkt_size = 3;
}

U0 XhmRptHandle(U8 *rpt, I64 len)
{
	I64 dx, dy, b, off, b_idx, x_idx, y_idx;

	if (len < 3)
		return;

	off = 0;
	// Boot mouse reports are [buttons][X][Y][wheel?].  A pressed button
	// makes byte 0 nonzero, so only treat byte 0 as a report ID when there
	// is room for ID + at least a 4-byte mouse report.
	if (len >= 5)
	{
		if (rpt[0] >= 1)
		{
			if (rpt[0] <= 15)
				off = 1;
		}
	}
	b_idx = off;
	x_idx = off + 1;
	y_idx = off + 2;
	if (len <= y_idx)
		return;

	// Boot report: [buttons][X][Y][wheel?]. Report-protocol prepends a report ID byte.
	b = rpt[b_idx] & 7;
	if (rpt[x_idx] & 0x80)
		dx = rpt[x_idx] - 256;
	else
		dx = rpt[x_idx];
	if (rpt[y_idx] & 0x80)
		dy = rpt[y_idx] - 256;
	else
		dy = rpt[y_idx];

	usb.ms_acc_x += dx;
	usb.ms_acc_y += dy;
	usb.ms_acc_b = b;
}

U0 XhmAccFlush()
{
	I64 dx, dy, b, ox, oy;

	if (!(sys_usb_input_active & UM))
		return;

	PUSHFD
	CLI
	dx = usb.ms_acc_x;
	dy = usb.ms_acc_y;
	b = usb.ms_acc_b;
	ox = dx;
	oy = dy;
	if (dx > 127)
	{
		usb.ms_acc_x = dx - 127;
		dx = 127;
	}
	else if (dx < -127)
	{
		usb.ms_acc_x = dx + 127;
		dx = -127;
	}
	else
		usb.ms_acc_x = 0;
	if (dy > 127)
	{
		usb.ms_acc_y = dy - 127;
		dy = 127;
	}
	else if (dy < -127)
	{
		usb.ms_acc_y = dy + 127;
		dy = -127;
	}
	else
		usb.ms_acc_y = 0;
	POPFD

	if (!dx)
	{
		if (!dy)
		{
			if (b == usb.ms_last_btn)
			{
				if (!ox)
				{
					if (!oy)
						return;
				}
			}
		}
	}
	usb.ms_last_btn = b;
	XhmPktIns(dx, dy, b);
}



U0 XhmEvtHandle()
{
	U8 *buf;

	PUSHFD
	CLI
	if (!usb.ms_pending)
	{
		POPFD
		return;
	}
	if (!usb.ms_xfer_done)
	{
		POPFD
		return;
	}
	if (!usb.ms_ring)
	{
		POPFD
		return;
	}
	buf = usb.ctrl_buf + udma_ms;
	if (usb.ms_xfer_len)
		XhmRptHandle(buf, usb.ms_xfer_len);
	usb.ms_pending = FALSE;
	usb.ms_xfer_done = FALSE;
	POPFD
	XhmIntrSub();
}

public U0 UsbPollEvt()
{
	static I64 poll_count = 0;

	if (!usb.active)
		return;
	if (usb.irq)
		return;
	if (sys_usb_input_active & UK)
	{
		if (usb.kbd_ring && !usb.kbd_pending && !usb.kbd_xfer_done)
			XhkIntrSub();
	}
	if (sys_usb_input_active & UM)
	{
		if (usb.ms_ring && !usb.ms_pending && !usb.ms_xfer_done)
			XhmIntrSub();
	}
	XHCIEventAdvance(64);
	XhkEvtHandle();
	XhmEvtHandle();
	poll_count++;
	if (poll_count < 2000)
	{
		if (!(poll_count % 100))
			UsbBootLastWrite;
	}
}
