U0 XhmPktIns(I64 dx, I64 dy, I64 b, I64 dz)
{
	I64 ps2[4];

	ps2[0] = 0;
	if (b & 1)
		ps2[0] |= 1;
	if (b & 2)
		ps2[0] |= 2;
	if (b & 4)
		ps2[0] |= 4;
	if (dx < 0)
	{
		ps2[0] |= 0x10;
		ps2[1] = 256 + dx;
	}
	else
		ps2[1] = dx;
	if (dy > 0)
	{
		ps2[0] |= 0x20;
		ps2[2] = 256 - dy;
	}
	else
		ps2[2] = -dy;
	ps2[3] = 0;
	if (dz < 0)
	{
		ps2[3] = (-dz) & 7;
		ps2[3] |= 0x08;
	}
	else if (dz > 0)
		ps2[3] = dz & 7;

	mouse_hard.timestamp = TSCGet;
	FifoU8Insert(mouse_hard.fifo2, ps2[0]);
	FifoU8Insert(mouse_hard.fifo2, ps2[1]);
	FifoU8Insert(mouse_hard.fifo2, ps2[2]);
	FifoU8Insert(mouse_hard.fifo2, ps2[3]);
	mouse_hard.pkt_size = 4;
}

U0 XhmRptDbg(U8 *rpt, I64 len)
{
	I64 i;

	usb.ms_last_len = len;
	MemSet(usb.ms_last_bytes, 0, 16);
	i = 0;
	while (i < len)
	{
		if (i >= 16)
			break;
		usb.ms_last_bytes[i] = rpt[i];
		i++;
	}
}

U0 XhmRptRel(U8 *rpt, I64 len)
{
	I64 dx, dy, dz, b, off, b_idx, x_idx, y_idx, w_idx, wheel;

	off = 0;
	// Boot mouse reports are [buttons][X][Y][wheel?].  A pressed button
	// makes byte 0 nonzero, so only treat byte 0 as a report ID when there
	// is room for ID + at least a 4-byte mouse report.
	if (len >= 5)
	{
		if (rpt[0] >= 1)
		{
			if (rpt[0] <= 15)
				off = 1;
		}
	}
	b_idx = off;
	x_idx = off + 1;
	y_idx = off + 2;
	if (len <= y_idx)
		return;

	b = rpt[b_idx] & 7;
	if (rpt[x_idx] & 0x80)
		dx = rpt[x_idx] - 256;
	else
		dx = rpt[x_idx];
	if (rpt[y_idx] & 0x80)
		dy = rpt[y_idx] - 256;
	else
		dy = rpt[y_idx];

	usb.ms_acc_x += dx;
	usb.ms_acc_y += dy;
	usb.ms_acc_b = b;
	w_idx = off + 3;
	if (len > w_idx)
	{
		wheel = rpt[w_idx];
		if (wheel & 0x80)
			dz = wheel - 256;
		else
			dz = wheel;
		usb.ms_acc_z += dz;
	}
}

U0 XhmRptHandle(U8 *rpt, I64 len)
{
	if (len < 3)
		return;

	XhmRptDbg(rpt, len);
	// Pass 1 for usb-tablet: log raw bytes; absolute parse comes next.
	if (usb.ms_abs)
		return;
	XhmRptRel(rpt, len);
}

U0 XhmAccFlush()
{
	I64 dx, dy, dz, b, ox, oy, oz;

	if (!(sys_usb_input_active & UM))
		return;

	PUSHFD
	CLI
	dx = usb.ms_acc_x;
	dy = usb.ms_acc_y;
	dz = usb.ms_acc_z;
	b = usb.ms_acc_b;
	ox = dx;
	oy = dy;
	oz = dz;
	if (dx > 127)
	{
		usb.ms_acc_x = dx - 127;
		dx = 127;
	}
	else if (dx < -127)
	{
		usb.ms_acc_x = dx + 127;
		dx = -127;
	}
	else
		usb.ms_acc_x = 0;
	if (dy > 127)
	{
		usb.ms_acc_y = dy - 127;
		dy = 127;
	}
	else if (dy < -127)
	{
		usb.ms_acc_y = dy + 127;
		dy = -127;
	}
	else
		usb.ms_acc_y = 0;
	if (dz > 7)
	{
		usb.ms_acc_z = dz - 7;
		dz = 7;
	}
	else if (dz < -7)
	{
		usb.ms_acc_z = dz + 7;
		dz = -7;
	}
	else
		usb.ms_acc_z = 0;
	POPFD

	if (!dx)
	{
		if (!dy)
		{
			if (!dz)
			{
				if (b == usb.ms_last_btn)
				{
					if (!ox)
					{
						if (!oy)
						{
							if (!oz)
								return;
						}
					}
				}
			}
		}
	}
	usb.ms_last_btn = b;
	XhmPktIns(dx, dy, b, dz);
}



U0 XhmEvtHandle()
{
	U8 *buf;

	PUSHFD
	CLI
	if (!usb.ms_pending)
	{
		POPFD
		return;
	}
	if (!usb.ms_xfer_done)
	{
		POPFD
		return;
	}
	if (!usb.ms_ring)
	{
		POPFD
		return;
	}
	buf = usb.ctrl_buf + udma_ms;
	if (usb.ms_xfer_len && XhcXferOk(usb.ms_xfer_code))
		XhmRptHandle(buf, usb.ms_xfer_len);
	usb.ms_pending = FALSE;
	usb.ms_xfer_done = FALSE;
	POPFD
	XhmIntrSub();
}

public U0 UsbPollEvt()
{
	if (!usb.active)
		return;
	if (usb.irq)
		return;
	if (sys_usb_input_active & UK)
	{
		if (usb.kbd_ring && !usb.kbd_pending && !usb.kbd_xfer_done)
			XhkIntrSub();
	}
	if (sys_usb_input_active & UM)
	{
		if (usb.ms_ring && !usb.ms_pending && !usb.ms_xfer_done)
			XhmIntrSub();
	}
	XHCIEventAdvance(64);
	XhkEvtHandle();
	XhmEvtHandle();
}
